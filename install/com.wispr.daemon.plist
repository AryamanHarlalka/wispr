<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Wispr daemon LaunchAgent.

  Runs ~/Applications/Wispr.app rather than .venv/bin/python. macOS attributes
  microphone and Accessibility consent to the running bundle, and the stock
  framework Python resolves to Python.app — which is signed with the hardened
  runtime but WITHOUT the audio-input entitlement, so it can never actually be
  granted the microphone (it opens the device and returns silence). Wispr.app
  is our own ad-hoc-signed copy with no hardened runtime, which can be granted.
  See install/build-app.sh for why, and install/install.sh for how.

  Because the interpreter now lives inside the bundle it can no longer find
  its own stdlib or the venv by relative path, hence PYTHONHOME/PYTHONPATH.

  The double-underscore placeholders below are substituted by install.sh;
  do not edit this file in place after install — re-run install.sh instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wispr.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>__APP_BIN__</string>
        <string>-m</string>
        <string>wispr</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WORKDIR__</string>

    <!-- Start at login, and bring it back if it ever dies. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Don't hot-loop if it's crashing on boot (e.g. mic permission denied). -->
    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>ProcessType</key>
    <string>Interactive</string>
    <!-- Keyboard/audio latency matters more than battery here. -->
    <key>Nice</key>
    <integer>-5</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.wispr/logs/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.wispr/logs/daemon.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd gives a near-empty PATH; faster-whisper and pbpaste need this. -->
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!-- Keep BLAS from grabbing every core and starving the UI. -->
        <key>OMP_NUM_THREADS</key>
        <string>4</string>
        <!-- The interpreter lives in the bundle now, so it can no longer find
             its own stdlib or the venv by relative path. -->
        <key>PYTHONHOME</key>
        <string>__PYTHONHOME__</string>
        <key>PYTHONPATH</key>
        <string>__PYTHONPATH__</string>
    </dict>
</dict>
</plist>

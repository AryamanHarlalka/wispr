<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Murmur daemon LaunchAgent.
  __PYTHON__ and __WORKDIR__ are substituted by install.sh; do not edit
  this file in place after install — re-run install.sh instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.murmur.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>murmur</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WORKDIR__</string>

    <!-- Start at login, and bring it back if it ever dies. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Don't hot-loop if it's crashing on boot (e.g. mic permission denied). -->
    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- Keyboard/audio latency matters more than battery here. -->
    <key>Nice</key>
    <integer>-5</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.murmur/logs/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.murmur/logs/daemon.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd gives a near-empty PATH; faster-whisper and pbpaste need this. -->
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!-- Keep BLAS from grabbing every core and starving the UI. -->
        <key>OMP_NUM_THREADS</key>
        <string>4</string>
    </dict>
</dict>
</plist>
